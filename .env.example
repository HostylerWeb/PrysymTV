# =============================================================================
# Prysym TV — environment reference (copy sections to the right files)
# =============================================================================
# Frontend → .env.local (repo root, never commit)
# API      → api/.env (never commit)
# =============================================================================

# --- Frontend (.env.local) ---------------------------------------------------

# Required — REST API base (includes /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional — Socket.IO host (no /api/v1); live chat derives from API URL if omitted
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional — client upload guard; should match API UPLOAD_MAX_BYTES
NEXT_PUBLIC_UPLOAD_MAX_BYTES=2147483648

# Optional — fallback thumbnail when API returns no thumbnail URL
NEXT_PUBLIC_MEDIA_PLACEHOLDER_URL=

# Optional — default profile photo when user has not uploaded one
# NEXT_PUBLIC_DEFAULT_AVATAR_URL=

# Go Live — RTMP server label in settings (match api/.env RTMP_INGEST_URL)
NEXT_PUBLIC_RTMP_INGEST_URL=rtmp://localhost:1935/live

# Admin dashboard UI preview (mock data, no API) — set true to review /admin without admin role
# NEXT_PUBLIC_ADMIN_UI_PREVIEW=true

# --- API (api/.env) ----------------------------------------------------------

DATABASE_URL=postgresql://prysym:prysym_dev_password@localhost:5433/prysymtv?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-32
JWT_REFRESH_SECRET=change-me-use-another-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000/api/v1
API_BUILD_ID=local-dev
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
NODE_ENV=development

# Storage: local (dev) or s3 (Cloudflare R2 / S3-compatible)
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:4000/api/v1/media/files
MEDIA_STATIC_SERVE_PATH=/api/v1/media/files

# When STORAGE_DRIVER=s3
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://your-cdn-or-r2-public-domain

STORAGE_RAW_KEY_PREFIX=uploads/raw
STORAGE_HLS_KEY_PREFIX=uploads/hls
STORAGE_THUMBNAIL_KEY_PREFIX=uploads/thumbnails
STORAGE_RAW_KEY_PATTERN={videoId}/source{extension}
STORAGE_PRESIGN_EXPIRES_SECONDS=3600
UPLOAD_MAX_BYTES=2147483648
UPLOAD_ALLOWED_MIME_PREFIXES=video/,audio/

# Video processing — ffmpeg (HLS + thumb) | skip (raw URL only)
VIDEO_PROCESSING_MODE=skip
VIDEO_PROCESSING_MAX_RETRIES=3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# VIDEO_PROCESSING_TMP_DIR=

# Live ingest (MediaMTX) — docker compose up -d mediamtx
RTMP_INGEST_URL=rtmp://localhost:1935/live
MEDIAMTX_HLS_PUBLIC_URL=http://localhost:8888

# Stripe (coins + premium) — omit for dev-mode instant grants
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: http://localhost:4000/api/v1/billing/stripe/webhook

# SMTP (password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-address@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-address@example.com

# Dev only (api/.env): AUTO_APPROVE_STREAMER=true — instant streamer approval without admin UI
