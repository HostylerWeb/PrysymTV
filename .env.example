# =============================================================================
# Prysym TV — Frontend template (.env.local)
# Copy to .env.local and fill in values. Never commit .env.local.
#
# API / database / secrets → api/.env (see api/.env.example)
# =============================================================================

# Required — REST API base (includes /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional — Socket.IO host (no /api/v1); live chat derives from API URL if omitted
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional — client upload guard; should match API UPLOAD_MAX_BYTES
NEXT_PUBLIC_UPLOAD_MAX_BYTES=2147483648

# OAuth — configured on the API only (api/.env GOOGLE_CLIENT_ID / APPLE_CLIENT_ID / FACEBOOK_APP_ID).
# Web and mobile fetch public client IDs from GET /config/public at runtime.
# Optional local fallback if the API is unreachable during development:
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_APPLE_CLIENT_ID=com.prysym.web
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Optional — fallback thumbnail when API returns no thumbnail URL
NEXT_PUBLIC_MEDIA_PLACEHOLDER_URL=

# Optional — default profile photo when user has not uploaded one
# NEXT_PUBLIC_DEFAULT_AVATAR_URL=

# Go Live — RTMP server label in settings (match api/.env RTMP_INGEST_URL)
NEXT_PUBLIC_RTMP_INGEST_URL=rtmp://localhost:1935/live

# Admin dashboard UI preview (mock data, no API) — set true to review /admin without admin role
NEXT_PUBLIC_ADMIN_UI_PREVIEW=false
