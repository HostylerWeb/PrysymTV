{
  "name": "tv-projector",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "prebuild": "EXPO_TV=1 expo prebuild --platform android",
    "prebuild:clean": "EXPO_TV=1 expo prebuild --platform android --clean",
    "build:apk:debug": "bash scripts/build-android.sh assembleDebug",
    "build:apk:release": "bash scripts/build-android.sh assembleRelease",
    "publish:ota": "bash scripts/publish-ota.sh",
    "build:release:ota": "bash scripts/build-release-with-ota.sh",
    "install:apk:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "install:apk:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^54.0.0",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eoas": "^3.1.2",
    "typescript": "~5.9.2"
  }
}
