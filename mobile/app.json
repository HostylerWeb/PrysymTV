{
  "expo": {
    "name": "PrysymTV",
    "slug": "prysymtv",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "prysymtv",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#030303"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "PrysymTV uses your camera for live broadcasts.",
        "NSMicrophoneUsageDescription": "PrysymTV uses your microphone for live broadcasts."
      }
    },
    "android": {
      "package": "tv.prysym.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#030303",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://srv1765056.hstgr.cloud/api/v1"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PrysymTV to access your photos to update your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030303",
          "image": "./assets/splash-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsPictureInPicture": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-navigation-bar"
    ]
  }
}
