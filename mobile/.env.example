# Copy to .env for local overrides (Expo loads EXPO_PUBLIC_* automatically).

# Use local API when developing on web (avoids CORS if production CORS is not updated):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# EXPO_PUBLIC_WS_URL=http://localhost:4000

# Production API (default via app.json extra.apiUrl):
# EXPO_PUBLIC_API_BASE_URL=https://srv1765056.hstgr.cloud/api/v1

# UI-only mock auth (no real API calls on failure):
# EXPO_PUBLIC_MOCK_AUTH=true
